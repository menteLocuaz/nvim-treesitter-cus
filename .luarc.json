{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "pathStrict": true
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME",
      "${3rd}/busted/library",
      "${3rd}/luassert/library"
    ],
    "ignoreDir": [
      ".git",
      ".github",
      ".test-deps",
      "build",
      "vendor"
    ],
    "checkThirdParty": "Disable"
  },
  "diagnostics": {
    "globals": [
      "vim"
    ],
    "unusedLocalExclude": [
      "_*"
    ],
    "groupFileStatus": {
      "strict": "Opened",
      "strong": "Opened"
    },
    "groupSeverity": {
      "strong": "Warning",
      "strict": "Warning"
    }
  },
  "type": {
    "castNumberToInteger": true,
    "weakUnionCheck": true
  }
}
